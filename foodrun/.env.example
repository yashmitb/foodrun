# Copy to .env and fill in. .env is gitignored.
# Leave everything blank to run on mock data with the demo sign-in.
# Full instructions: docs/SETUP.md

# Supabase → Project Settings → API. Both are safe in a client build;
# the RLS policies in supabase/migrations/0002_rls.sql are what protect data.
# The service_role key from that page goes nowhere near this file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Real card holds, via the payments Edge Function. Requires Supabase above
# and STRIPE_SECRET_KEY set as a function secret, never here.
# Off by default: having a backend is not consent to charge cards in a demo.
EXPO_PUBLIC_ENABLE_STRIPE=false
